#!/usr/bin/env python3

# 1. imports: standard library first, then third-party
import argparse
from urllib.parse import urlparse
from html.parser import HTMLParser

import requests

# 2. constants
HEADERS = {
	'User-Agent': 'Mozilla/5.0 (compatible; arachnida-spider/1.0)'
}

# 3. classes
class ExtractImgLink(HTMLParser):
	def __init__(self): # initialize the class
		super().__init__() #parent class constructor
		self.images = []
		self.links = []
	def handle_starttag(self, tag, attrs):
		# maybe include source/srcset(needs extra parsing)
		if tag == 'img':
			for name, value in attrs:
				if name == 'src' and value:
					self.images.append(value)

		if tag == 'a':
			for name, value in attrs:
				if name == 'href' and value:
					self.links.append(value)


# 4, functions
def build_parser():
	parser = argparse.ArgumentParser(description='Download images from a URL.')
	parser.add_argument('URL', help='URL to download images from.')
	parser.add_argument('-r', help='Recursively downloads the images in a URL received as a parameter.',
						action='store_true')
	parser.add_argument('-l', help='Indicates the maximum depth level of the recursive download.',
						type=int)
	parser.add_argument('-p', help='Indicates the path where the downloaded files will be saved.',
						default='./data')
	return parser


def validate_args(args, parser):
	url = urlparse(args.URL)
	
	if args.l is not None and not args.r:
		parser.error('Maximum depth level can only be specified when recursive download is enabled.')
	if args.l is not None and args.l <= 0:
		parser.error('Maximum depth level must be a positive integer.')
	if args.r and args.l is None:
		args.l = 5
	if url.scheme not in ('http', 'https'):
		parser.error("URL must start with 'http://' or 'https://'.")
	if not url.netloc:
		parser.error('URL must be valid.')


def fetch_page(url):
	res = requests.get(url, headers=HEADERS, timeout=5)
	if res.status_code >= 400:
		res.raise_for_status()
	return res.text
	

def get_images_from_page(html, base_url, path):
	get_img_link = ExtractImgLink()
	get_img_link.feed(html)
	print(get_img_link.images)
	print(get_img_link.links)


def main():
	parser = build_parser()
	args = parser.parse_args()
	validate_args(args, parser)

	try:
		url_text = fetch_page(args.URL)
	except requests.RequestException as e:
		print(f'Error fetching {args.URL}: {e}')
		# we shouldn't return when -r is used, since the crawler should continue to run and try to fetch other pages, if any
		return

	get_images_from_page(url_text, args.URL, args.p)


# 5. entry point
if __name__ == '__main__':
	main()
