def main():
	parser = build_parser()
	args = parser.parse_args()
	validate_args(args, parser)

	# needs to use try-except block to catch the 
	# HTTPError exception and print a custom error message
	try:
		url_text = fetch_page(args.URL)
	except requests.RequestException as e:
		print(f'Error fetching {args.URL}: {e}')
		return

	get_images_from_page(url_text, args.URL, args.p)
	# print_args(args)

if __name__ == '__main__':
	main()

