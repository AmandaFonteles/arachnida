#!/usr/bin/env python3

# Library imports
import argparse
from urllib.parse import urlparse
from html.parser import HTMLParser

import requests

HEADERS = {
	'User-Agent': 'Mozilla/5.0 (compatible; arachnida-spider/1.0)'
}

def build_parser():
	parser = argparse.ArgumentParser(description='Download images from a URL.')
	parser.add_argument('URL', help='URL to download images from.')
	parser.add_argument('-r', help='Recursively downloads the images in a URL received as a parameter.',
						action='store_true')
	parser.add_argument('-l', help='Indicates the maximum depth level of the recursive download.',
						type=int)
	parser.add_argument('-p', help='Indicates the path where the downloaded files will be saved.',
						default='./data')
	return parser


def validate_args(args, parser):
	url = urlparse(args.URL)
	
	if args.l is not None and not args.r:
		parser.error('Maximum depth level can only be specified when recursive download is enabled.')
	if args.l is not None and args.l <= 0:
		parser.error('Maximum depth level must be a positive integer.')
	if args.r and args.l is None:
		args.l = 5
	if url.scheme not in ('http', 'https'):
		parser.error("URL must start with 'http://' or 'https://'.")
	if not url.netloc:
		parser.error('URL must be valid.')


# setting the headers to avoid 403 error:
# if we don't set the headers, it'll be set by default to 'python-requests/x.x.x'
# which reads as a script and can be seen as a bot
# some websites will block our requests and return a 403 error.
def fetch_page(url):
	res = requests.get(url, headers=HEADERS, timeout=3)
	# same as res.raise_for_status(), but with a custom error message
	if res.status_code >= 400:
		raise requests.HTTPError(f'HTTP error {res.status_code} for URL: {url}')
	return res.text
	

def get_images_from_page(html, base_url, path):
	#override the HTMLParser class to extract image URLs from the HTML
	class ImageParser(HTMLParser):
		
		def handle_starttag(self, tag, attrs):
			print('Tag:', tag)
			print('Attributes:', attrs)
	
	pars_html = ImageParser()
	pars_html.feed(html)

